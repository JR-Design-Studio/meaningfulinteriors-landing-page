---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getImage } from 'astro:assets';
import ogDefault from '../assets/img/living-room.webp';
import logoSrc from '../assets/img/logo-square.png';
import { absolute, breadcrumbs as crumbList, business } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata;
  imageAlt?: string;
  crumbs?: { name: string; path: string }[];
  jsonLd?: object[];
  /** El encabezado arranca transparente sobre la foto principal */
  overlay?: boolean;
  noindex?: boolean;
}

const {
  title,
  description,
  image = ogDefault,
  imageAlt = 'Living room designed by Meaningful Interiors in Los Angeles',
  crumbs,
  jsonLd = [],
  overlay = true,
  noindex = false,
} = Astro.props;

// En build las páginas salen como /about.html; la URL pública es /about
const canonical = absolute(Astro.url.pathname.replace(/(index)?\.html$|\/$/, '') || '/');
const og = await getImage({ src: image, width: Math.min(1200, image.width), format: 'jpg' });
const ogDefaultImg = await getImage({ src: ogDefault, width: 1200, format: 'jpg' });
const logo = await getImage({ src: logoSrc, width: 400, format: 'png' });

const schema = [
  business(absolute(ogDefaultImg.src), absolute(logo.src)),
  ...(crumbs?.length ? [crumbList(crumbs)] : []),
  ...jsonLd,
];
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#f3efe8" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Meaningful Interiors" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absolute(og.src)} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[70] focus:bg-ink focus:px-4 focus:py-2 focus:text-bone"
      >Skip to content</a
    >
    <Header overlay={overlay} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Ejecuta fn cuando la foto ya cargó (o de inmediato si ya estaba lista)
      const whenLoaded = (img: HTMLImageElement | null, fn: () => void) => {
        if (!img || (img.complete && img.naturalWidth)) return fn();
        img.addEventListener('load', fn, { once: true });
        img.addEventListener('error', fn, { once: true });
      };

      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (!e.isIntersecting) continue;
            const el = e.target as HTMLElement;
            if (el.hasAttribute('data-curtain')) {
              // La cortina se abre cuando su foto ya está lista, nunca sobre un hueco vacío.
              // Una foto "lazy" recortada del todo nunca empezaría a descargarse: se fuerza la carga,
              // y si algo falla la cortina se abre igual a los 1.5 s.
              const img = el.querySelector('img');
              if (img) img.loading = 'eager';
              const open = () => el.classList.add('is-in');
              whenLoaded(img, open);
              setTimeout(open, 1500);
            } else el.classList.add('is-in');
            io.unobserve(el);
          }
        },
        { rootMargin: '0px 0px -40px 0px' },
      );
      document.querySelectorAll('[data-curtain], [data-rise]').forEach((el) => io.observe(el));

      // Fotos sin cortina: aparecen en cuanto están a la vista y terminaron de cargar
      const imgObserver = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const img = e.target as HTMLImageElement;
          whenLoaded(img, () => img.setAttribute('data-shown', ''));
          imgObserver.unobserve(img);
        }
      });
      document
        .querySelectorAll<HTMLImageElement>('main img')
        .forEach((img) => !img.closest('[data-curtain]') && imgObserver.observe(img));
    </script>
  </body>
</html>
