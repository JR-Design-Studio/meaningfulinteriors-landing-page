---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { faqPage } from '../lib/seo';

import livingRoom from '../assets/img/living-room.webp';
import heroHome from '../assets/img/hero-home.webp';
import kitchenSage from '../assets/img/kitchen-sage.webp';
import bedroom from '../assets/img/bedroom-blue-grey.webp';
import livingSage from '../assets/img/living-sage.png';
import closet from '../assets/img/closet-walk-in.webp';
import dining from '../assets/img/dining-room.webp';
import kitchenBrass from '../assets/img/kitchen-brass-pendants.jpg';
import diningLiving from '../assets/img/dining-living.jpg';
import flatlay from '../assets/img/material-flatlay.webp';

const poster = await getImage({ src: flatlay, width: 1280, format: 'webp' });

const faqs = [
  {
    q: 'Do you offer luxury interior design services in Los Angeles?',
    a: 'Yes. We specialize in high-end residential interior design throughout Los Angeles, CA.',
  },
  {
    q: 'Is neurodesign only about minimalism?',
    a: 'No. Neurodesign is about balance, clarity, and intention — not a specific style.',
  },
  {
    q: 'Do you offer full-service interior design?',
    a: 'Yes. We offer full-service interior design from concept through execution.',
  },
  {
    q: 'How do I start working with Meaningful Interiors?',
    a: 'You can begin by booking a discovery call to explore your project and goals.',
  },
];

const effects = [
  'Reduce visual overwhelm and mental fatigue',
  'Improve flow, focus, and emotional balance',
  'Feel effortless, elevated, and deeply personal',
  'Support your lifestyle, routines, and well-being',
];

const services = [
  {
    href: '/interior-design-services',
    title: 'Full-Service Interior Design',
    text: 'Concept, spatial planning, selections and sourcing, guided through implementation.',
    image: livingSage,
    alt: 'Living room with a sage green sofa and sculptural pendant light',
  },
  {
    href: '/neurodesign-closet-design-los-angeles',
    title: 'Neurodesign Closet Design',
    text: 'Luxury closets that reduce daily stress and help your mornings feel lighter.',
    image: closet,
    alt: 'Luxury walk-in closet with warm lighting and a central ottoman',
  },
];

const gallery = [
  { image: dining, alt: 'Dining room with a marble table and ochre velvet chairs', cls: 'md:col-span-5 aspect-[4/5]' },
  { image: kitchenBrass, alt: 'Charcoal kitchen with brass-lined pendants and walnut stools', cls: 'md:col-span-4 md:mt-24 aspect-[3/4]' },
  { image: diningLiving, alt: 'Open dining and living area with wood slat walls', cls: 'md:col-span-3 md:mt-48 aspect-[3/4]' },
];
---

<Base
  title="Neurodesign Interior Designer | Los Angeles | Meaningful Interiors"
  description="Luxury interior design in Los Angeles rooted in neurodesign. Timeless, intentional interiors designed to support well-being, clarity, and elevated everyday living."
  jsonLd={[faqPage(faqs)]}
>
  <PageHero
    image={heroHome}
    alt="Living room designed by Meaningful Interiors with soft neutrals and a sculptural chandelier"
    lede="Timeless, intentional interiors designed to support well-being, clarity, and elevated everyday living."
    cta={{ href: '/contactus', label: 'Book a Discovery Call' }}
  >
    Luxury interiors that don’t just look beautiful, but <em>feel right</em>.
  </PageHero>

  <!-- Intro -->
  <section class="px-6 py-28 md:px-10 md:py-40">
    <div class="mx-auto grid max-w-[1520px] gap-12 lg:grid-cols-12">
      <div class="lg:col-span-9 lg:col-start-4">
        <p class="font-display text-subtitle text-pretty md:text-[clamp(1.75rem,2.7vw,2.6rem)] md:leading-[1.18]" data-rise>
          At Meaningful Interiors, we create luxury interior design experiences in Los Angeles guided by neurodesign
          principles, designing spaces that support how you live, think, rest, and recharge.
        </p>
        <p class="mt-10 max-w-2xl text-lg text-stone" data-rise style="--d:120ms">
          We design interiors that bring calm, flow, and meaning into daily life through thoughtful layouts, refined
          materials, and intentional details.
        </p>
      </div>
    </div>
  </section>

  <!-- Beyond aesthetics -->
  <section class="px-6 pb-28 md:px-10 md:pb-40">
    <div class="mx-auto grid max-w-[1520px] items-center gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="lg:col-span-6" data-curtain>
        <Image
          src={kitchenSage}
          alt="Sage green neurodesign kitchen with brass pendants and velvet stools"
          widths={[640, 960]}
          sizes="(min-width: 1024px) 45vw, 100vw"
          class="aspect-[4/5] w-full object-cover"
        />
      </div>
      <div class="lg:col-span-6 lg:col-start-7">
        <h2 class="font-display text-title text-balance" data-rise>
          Most interior design focuses on style. Ours focuses on how space affects the mind.
        </h2>
        <p class="mt-8 text-lg text-stone" data-rise>Through neurodesign, we create interiors that:</p>
        <ul class="mt-6 space-y-4">
          {
            effects.map((e, i) => (
              <li class="flex gap-5 text-lg" data-rise style={`--d:${i * 70}ms`}>
                <span class="mt-3.5 h-px w-6 shrink-0 bg-brass" aria-hidden="true" />
                {e}
              </li>
            ))
          }
        </ul>
        <p class="mt-12 font-display text-2xl italic text-ink/80" data-rise>
          Luxury here is not excess; it’s clarity, intention, and longevity.
        </p>
      </div>
    </div>
  </section>

  <!-- What is neurodesign -->
  <section class="bg-espresso px-6 py-28 text-bone md:px-10 md:py-40">
    <div class="mx-auto grid max-w-[1520px] items-center gap-14 lg:grid-cols-12 lg:gap-20">
      <div class="order-2 lg:order-1 lg:col-span-6">
        <h2 class="font-display text-title text-balance" data-rise>What is neurodesign in interior design?</h2>
        <p class="mt-8 max-w-xl text-xl text-bone/80" data-rise>
          Neurodesign applies neuroscience principles to interior design to create spaces that positively influence
          mood, focus, and well-being.
        </p>
        <p class="mt-6 max-w-xl text-bone/65" data-rise>
          Thoughtful layouts, material selection, lighting, and spatial flow work together so a room feels supportive
          rather than overwhelming. It isn’t a style; it’s a way of deciding.
        </p>
      </div>
      <figure class="order-1 lg:order-2 lg:col-span-5 lg:col-start-8" data-curtain>
        <Image
          src={bedroom}
          alt="Neurodesign bedroom in soft blue-grey and green-grey tones"
          widths={[640, 1000]}
          sizes="(min-width: 1024px) 38vw, 100vw"
          class="aspect-[4/5] w-full object-cover"
        />
        <figcaption class="mt-4 text-sm text-bone/55">
          Soft blue-grey and green-grey tones chosen to support deep rest and emotional restoration.
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- Services -->
  <section class="px-6 py-28 md:px-10 md:py-40">
    <div class="mx-auto max-w-[1520px]">
      <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
        <div>
          <h2 class="max-w-2xl font-display text-title text-balance" data-rise>Two ways to work together.</h2>
        </div>
      </div>
      <div class="mt-16 grid gap-10 md:grid-cols-2 md:gap-8">
        {
          services.map((s, i) => (
            <a href={s.href} class="group block" data-rise style={`--d:${i * 120}ms`}>
              <div class="overflow-hidden">
                <Image
                  src={s.image}
                  alt={s.alt}
                  widths={[640, 960, 1280]}
                  sizes="(min-width: 768px) 48vw, 100vw"
                  class="aspect-[5/4] w-full object-cover transition-transform duration-[1.6s] ease-calm group-hover:scale-[1.04]"
                />
              </div>
              <div class="mt-6 flex items-start justify-between gap-6">
                <div>
                  <h3 class="font-display text-3xl">{s.title}</h3>
                  <p class="mt-2 max-w-md text-stone">{s.text}</p>
                </div>
                <span class="mt-2 grid size-12 shrink-0 place-items-center rounded-full border border-ink/20 transition-colors group-hover:bg-ink group-hover:text-bone" aria-hidden="true">→</span>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Gallery -->
  <section class="px-6 pb-28 md:px-10 md:pb-40">
    <div class="mx-auto max-w-[1520px]">
      <div class="grid gap-6 md:grid-cols-12 md:gap-8">
        {
          gallery.map((g) => (
            <div class:list={['overflow-hidden', g.cls]} data-curtain>
              <Image src={g.image} alt={g.alt} widths={[480, 800, 1200]} sizes="(min-width: 768px) 40vw, 100vw" class="size-full object-cover" />
            </div>
          ))
        }
      </div>
      <p class="mt-10 max-w-md font-display text-xl italic text-stone" data-rise>
        Every decision, from layout to materials, lighting, and color, is made with purpose.
      </p>
    </div>
  </section>

  <!-- Studio film -->
  <section class="px-6 pb-28 md:px-10 md:pb-40">
    <div class="mx-auto grid max-w-[1520px] items-center gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 class="font-display text-title" data-rise>A closer look.</h2>
        <p class="mt-6 max-w-sm text-stone" data-rise>We design spaces to support how you live, feel, and move through life.</p>
      </div>
      <div class="lg:col-span-7 lg:col-start-6" data-rise>
        <video
          class="aspect-video w-full bg-espresso object-cover"
          src="/media/studio.mp4"
          controls
          playsinline
          preload="none"
          poster={poster.src}
          aria-label="Studio video from Meaningful Interiors"></video>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="px-6 pb-28 md:px-10 md:pb-40">
    <div class="mx-auto grid max-w-[1520px] gap-12 lg:grid-cols-12">
      <div class="lg:col-span-4">
        <h2 class="font-display text-title" data-rise>Before we begin.</h2>
      </div>
      <div class="lg:col-span-8"><Faq items={faqs} /></div>
    </div>
  </section>

  <Cta
    title="Design a home that supports how you live."
    text="Luxury interior design rooted in clarity, calm, and intention."
    label="Book a Discovery Call"
    image={flatlay}
    alt="Material flat lay with stone, linen, and dried magnolia"
  />
</Base>
