---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found | Meaningful Interiors" description="This page could not be found." overlay={false} noindex>
  <section class="px-6 pt-48 pb-40 md:px-10">
    <div class="mx-auto max-w-[1520px]">
      <p class="font-display text-lg italic text-stone">Error 404</p>
      <h1 class="mt-6 max-w-3xl font-display text-hero">This room hasn’t been designed yet.</h1>
      <a href="/" class="mt-12 inline-flex items-center gap-3 rounded-full bg-ink px-7 py-4 text-[15px] text-bone">Back to home →</a>
    </div>
  </section>
</Base>
