---
interface Props {
  items: { q: string; a: string }[];
}
const { items } = Astro.props;
---

<div class="divide-y divide-ink/12 border-y border-ink/12">
  {
    items.map((f) => (
      <details class="group">
        <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-7 [&::-webkit-details-marker]:hidden">
          <h3 class="font-display text-xl md:text-2xl">{f.q}</h3>
          <span
            class="mt-1 grid size-8 shrink-0 place-items-center rounded-full border border-ink/20 transition-transform duration-500 ease-calm group-open:rotate-45"
            aria-hidden="true"
          >
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none"><path d="M6 1v10M1 6h10" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" /></svg>
          </span>
        </summary>
        <p class="max-w-3xl pb-8 text-stone">{f.a}</p>
      </details>
    ))
  }
</div>
