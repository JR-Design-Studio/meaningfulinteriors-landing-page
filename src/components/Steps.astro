---
import { roman } from '../lib/roman';

// Pasos del proceso con numerales romanos en cursiva
interface Props {
  steps: { title: string; text: string }[];
  tone?: 'dark' | 'light';
}
const { steps, tone = 'dark' } = Astro.props;
const cols = steps.length > 4 ? 'lg:grid-cols-3' : 'lg:grid-cols-4';
---

<ol class:list={['grid gap-x-10 gap-y-14 sm:grid-cols-2', cols]}>
  {
    steps.map((s, i) => (
      <li data-rise style={`--d:${(i % 4) * 90}ms`}>
        <span class="font-display text-5xl italic text-brass">{roman(i)}.</span>
        <h3 class:list={['mt-5 font-display text-2xl', tone === 'light' ? 'text-bone' : 'text-ink']}>{s.title}</h3>
        <p class:list={['mt-3', tone === 'light' ? 'text-bone/70' : 'text-stone']}>{s.text}</p>
      </li>
    ))
  }
</ol>
